# Plantaroo local AI bridge — copy to .env and adjust.
# .env is gitignored; never commit real values.

# Port the Express server listens on. Tailscale Funnel forwards to this port.
PORT=3100

# Interface to bind. 127.0.0.1 is enough because tailscaled terminates Funnel on
# this machine and proxies to localhost. Use 0.0.0.0 only to reach it from the LAN.
HOST=127.0.0.1

# Base URL of the local Ollama daemon.
OLLAMA_URL=http://127.0.0.1:11434

# Vision model used for BOTH /api/identify and /api/profile.
MODEL=qwen2.5vl:7b

# Firebase project whose ID tokens are accepted. Must match the app's project.
FIREBASE_PROJECT_ID=plantaroo-204ca

# 1 = disable auth for LOOPBACK callers (they get uid "dev").
#
# READ THIS: Tailscale Funnel traffic ARRIVES AS LOOPBACK. tailscaled terminates
# the public connection and proxies to 127.0.0.1, so a request from anywhere on
# the internet is indistinguishable from one typed on the console. Loopback is NOT
# a trust boundary here. Setting this to 1 on the exposed machine publishes
# /api/identify and /api/profile to the whole internet with no credentials.
#
# NEVER set this on the exposed machine. It is for a laptop with no Funnel config.
# As a guard, the server refuses to start when this is 1 and
# `tailscale funnel status` reports anything other than "No serve config".
DEV_ALLOW_NO_AUTH=0

# Optional: path to the tailscale CLI used by that startup guard. Only consulted
# when DEV_ALLOW_NO_AUTH=1.
# TAILSCALE_EXE=C:\Program Files\Tailscale\tailscale.exe
